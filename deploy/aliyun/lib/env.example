# =============================================================================
# my-coffee 阿里云部署凭证模板（env.example）
# -----------------------------------------------------------------------------
# 使用方法：
#   1. 复制本文件到【仓库外】，例如 ~/.aliyun-env
#        cp deploy/aliyun/lib/env.example ~/.aliyun-env
#   2. chmod 600 ~/.aliyun-env
#   3. 用真实值填入下面的占位（绝不填真实值到本文件、绝不提交进仓库）
#   4. source ~/.aliyun-env  后再执行 deploy/aliyun/ 下的脚本
# 脚本通过 source ../lib/common.sh 校验这些变量是否存在；缺失会立即报错退出。
# =============================================================================

# --- 阿里云 AK（显式 AK 模式，脚本不依赖本地 profile） ---
export ALIBABA_CLOUD_ACCESS_KEY_ID=
export ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# --- 地域（杭州为例；换地域只改这里 + 资源相关变量） ---
export REGION=cn-hangzhou

# --- 目标 ECS（单机 standalone 形态用；无公网，一切操作走 RunCommand/OSS 内网） ---
export ECS_ID=

# --- ACR 容器镜像服务（镜像走 VPC 端点 push/pull，不走公网；勿填公网形态默认） ---
#    企业版 VPC 端点形如 <registry>-vpc.<region>.cr.aliyuncs.com；个人版 registry-vpc.<region>.aliyuncs.com
export ACR_REGISTRY=                   # ACR VPC 端点（必填，common.sh :? fail-loud）
export ACR_NAMESPACE=                  # ACR 命名空间（必填）
export ACR_INSTANCE_ID=                # 企业版实例 ID；个人版留空

# --- OSS（无公网 ECS 经内网签名 URL 下载部署文件用） ---
export OSS_BUCKET=
#    OSS 内网域名前缀（一般形如 oss-${REGION}-internal.aliyuncs.com），脚本据此拼内网签名端点
export OSS_INTERNAL_HOST=oss-cn-hangzhou-internal.aliyuncs.com

# --- 镜像 tag（默认用 git 短 sha；这里可覆盖固定 tag/digest 做回滚） ---
export IMAGE_TAG=

# --- 对外入口（可选；走 FC 反代 + 免 ICP 域名，规避账号安全基线封 ECS 公网端口） ---
#    FC 服务/函数名，留空表示暂不部署对外入口
export FC_SERVICE_NAME=my-coffee-gateway
export FC_FUNCTION_NAME=my-coffee-proxy

# =============================================================================
# 方案二（FC + RDS PostgreSQL，整体上 FC）专用变量
# -----------------------------------------------------------------------------
# RDS PostgreSQL（VPC 内网实例；FC 与 RDS 同 VPC，DATABASE_URL 注入 FC 函数 env）
# connection_limit=3 钉在串尾 ?connection_limit=3（A2 单一事实源：Prisma 从 datasource URL 读连接上限）。
# 勿另设 CONNECTION_LIMIT env——两处定义同一事实会静默漂移（A2 已否决独立 env 读取）。
export RDS_DATABASE_URL=                  # postgresql://<user>:<pass>@<rds-vpc内网地址>:5432/<db>?connection_limit=3
# FC VPC 配置（函数访 RDS 内网的前提）
export FC_VPC_ID=
export FC_VSWITCH_ID=
export FC_SG_ID=                         # FC 函数绑定的安全组（RDS 安全组放行其 5432）
# FC HTTP 触发器免 ICP 域名（部署后填，healthcheck 用）
export FC_DOMAIN=                         # 如 https://<acct>.<region>.fcapp.run
# 连接池数学参考值（见 deploy/aliyun/fc-app/DESIGN.md 第五节，与后端数据层设计交叉校验）
# 注：connection_limit 实际由 RDS_DATABASE_URL 串尾控制（见上），此处不再单独定义。
# INSTANCE_CONCURRENCY / RDS_MAX_CONNECTIONS 仅为 §5 数学账的参考值（s.yaml 实际钉死 instanceConcurrency=10、maximumInstanceCount=20）。
export INSTANCE_CONCURRENCY=10            # FC 实例并发度（参考值，s.yaml 钉死）
# RDS max_connections 真实值（控制台查后填，用于连接池余量校验）
export RDS_MAX_CONNECTIONS=
