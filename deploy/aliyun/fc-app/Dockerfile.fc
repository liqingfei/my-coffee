# Dockerfile.fc — my-coffee FC custom-container 镜像（方案二：单函数托管 /api + 静态 + RDS PostgreSQL）
# 构建上下文为仓库根目录：
#   docker build -f deploy/aliyun/fc-app/Dockerfile.fc -t <tag> .
# 设计阶段模板，待 DESIGN.md 评审通过 + 后端 Prisma sqlite→postgresql 迁移落地后 bake 生效。
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/backend/package.json ./packages/backend/
COPY packages/frontend/package.json ./packages/frontend/
# schema 前置：postinstall `prisma generate` 在 npm ci 期间触发，须 schema.prisma 在场
# （CR 第4项 build 撞点 = postinstall generate 时 schema 缺席 → npm ci 炸于 line 10）
COPY packages/backend/prisma ./packages/backend/prisma
# 显式钉 Prisma CLI binary target（CR ga7zzjob 修向 (c)）：node:20-alpine 构建段缺 openssl CLI
# → npm ci postinstall 引擎下载探测失输 → 默认 openssl-1.1.x musl 变体（与 runtime 错配）。
# 钉 linux-musl-openssl-3.0.x → schema engine 焙对变体 link libssl.so.3，零缺口加载。
# 绕过不可靠探测组件，不修好再信它（一个机制族=显式声明，非声明+探测双机制）。
ENV PRISMA_CLI_BINARY_TARGETS=linux-musl-openssl-3.0.x
RUN npm ci
COPY packages/backend ./packages/backend
COPY packages/frontend ./packages/frontend
# 后端：Prisma generate（迁移后为 postgresql provider）+ tsc 编译
RUN cd packages/backend && npx prisma generate && npx tsc -p tsconfig.json
# 前端：Vite 构建
RUN cd packages/frontend && npx vite build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY packages/backend/package.json ./packages/backend/
COPY packages/frontend/package.json ./packages/frontend/
# 多阶段带过 build stage 已安装+已生成的完整 node_modules（含 @prisma/client runtime 面 +
# .prisma 生成面 + prisma CLI）→ runtime 零 npm ci = 零 postinstall 触发面 → generate 与
# CLI 缺席两个特殊情况一起消失（CR 第4项 runtime 撞点 = --omit=dev 砍 prisma devDep →
# postinstall `prisma generate` 无 CLI 炸于 && 前，后接显式 generate 走不到）。
# 镜像体积换正确性（demo 可接受；体积成问题再分层切 deps/--omit=dev 带 .prisma 单带方案）。
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/backend/dist ./packages/backend/dist
COPY --from=build /app/packages/backend/prisma ./packages/backend/prisma
COPY --from=build /app/packages/frontend/dist ./frontend-dist
COPY deploy/aliyun/fc-app/fc-server.js ./packages/backend/fc-server.js
WORKDIR /app/packages/backend
ENV FRONTEND_DIST=/app/frontend-dist \
    PORT=9000
# runtime 段 ENV 钉（build 段 ENV 不继承至 runtime 段，缺一即炸；Dev e13zdrmu/t6ekqku4 源码 + 02b 实证）：
#  #3 PRISMA_CLI_BINARY_TARGETS 重申 = build #1 的 runtime 侧镜像一致性锚点（generate 期消费面，
#     非 migrate 期——02b 实证：migrate 路 schema-engine resolver 走 #5 不读 #3；#3 是 generate 期
#     binariesExist 下载面变量，runtime 段无 generate 故实际 no-op，留作 belt 一致性锚点 TL 96pwd1oz 裁不删）。
#  #4 PRISMA_QUERY_ENGINE_LIBRARY 钉 query engine loader（@prisma/client library.js）=全路径非名
#     （Dev t6ekqku4 源码：loader za() env 置则原样当加载路径返回，零 binaryTarget 名→路径解析；
#     CR 9qtkhcse「优先用名」被证伪，全路径=正退路）。路径错=x64 dlopen loud error 非静默（④ 探针第一手可见）。
#     不钉则探测落 linux-musl（1.1.x 味）→ 04 必炸。落点：generate .prisma 落 root node_modules + L37
#     COPY --from=build /app/node_modules 整体带过→路径确定（bake 后 ls(⓪) belt 实证在场）。
#  #5 PRISMA_SCHEMA_ENGINE_BINARY 钉 schema engine（02b migrate 路）=全路径。Dev 5ws6rrho 源码实证
#     （prisma 5.22.0 build/index.js）：env-var map schema-engine→PRISMA_SCHEMA_ENGINE_BINARY（平行
#     query-engine→PRISMA_QUERY_ENGINE_LIBRARY=#4），resolver df()/wu() 读 env 置则 path.resolve 原样当
#     路径返回、零 probe（同 #4 机制族）。不钉则 get-platform probe（alpine 无 openssl CLI）→ default
#     openssl-1.1.x → 搜裸名 schema-engine-linux-musl 不在 → 02b abort（实证）。#5 落=双 engine 皆 env
#     路径钉零 probe，(c)「绕过探测组件」对两面统一成立。运行时 A/B 双锁（Dev 5ws6rrho）。
ENV PRISMA_CLI_BINARY_TARGETS=linux-musl-openssl-3.0.x \
    PRISMA_QUERY_ENGINE_LIBRARY=/app/node_modules/.prisma/client/libquery_engine-linux-musl-openssl-3.0.x.so.node \
    PRISMA_SCHEMA_ENGINE_BINARY=/app/node_modules/@prisma/engines/schema-engine-linux-musl-openssl-3.0.x
EXPOSE 9000
# 无状态服务（migrate 走 02b-migrate.sh 独立 fail-first 步骤，不在冷启；CR ga7zzjob 一致性扫
# 消 Dockerfile CMD × FC config command 双源——镜像 CMD 与 03 customContainerConfig.command 同款）。
CMD ["node","fc-server.js"]
