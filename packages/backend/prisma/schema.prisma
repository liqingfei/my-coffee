// 希希咖啡店 数据库 Schema（一期：M1 点单 + M2 配送；二期方案二：FC + RDS PostgreSQL）
// 状态字段用 String 承载，合法取值与流转在应用层（services）集中校验
// （引擎无关决策：PG 虽支持 enum，状态机校验仍归应用层，见 A2 §1）。

generator client {
  provider      = "prisma-client-js"
  // 显式钉 FC 镜像（node:20-alpine / Alpine 3）engine 变体：build 期缺 openssl CLI
  // 致探测默认 openssl-1.1.x musl 变体，Alpine 3 仅 libssl.so.3 → engine 加载失败
  // （CR ga7zzjob 终裁 (c)）。native 必留=本地开发机 generate 零变化。
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 咖啡菜单项
model MenuItem {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String   @db.VarChar(500)
  price       Decimal  @db.Decimal(10, 2) // 单价（元）。金额 2 位精度；读边界转 number，线协议 JSON number（A2 §2）
  category    String   @db.VarChar(50) // 分类：咖啡 / 茶饮 / 甜点
  imageUrl    String?  @db.VarChar(500)
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// 订单
model Order {
  id              Int       @id @default(autoincrement())
  items           String    @db.Text // JSON 字符串：[{menuItemId, name, quantity, price, subtotal}]
  totalPrice      Decimal   @db.Decimal(10, 2)
  status          String    @default("pending") @db.VarChar(20) // pending/confirmed/preparing/delivering/completed
  customerName    String    @db.VarChar(100)
  customerPhone   String    @db.VarChar(32)
  customerAddress String    @db.VarChar(255)
  createdAt       DateTime  @default(now())
  delivery        Delivery?
}

// 配送单（与订单 1:1，orderId 唯一）
model Delivery {
  id            Int      @id @default(autoincrement())
  orderId       Int      @unique
  order         Order    @relation(fields: [orderId], references: [id])
  status        String   @default("pending") @db.VarChar(20) // pending/picked_up/in_transit/delivered
  fee           Decimal  @default(5.0) @db.Decimal(10, 2) // 一期固定配送费 5 元
  estimatedTime Int? // 预计送达时间（分钟）
  createdAt     DateTime @default(now())
}
